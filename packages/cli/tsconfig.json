{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@asimov/shared": ["../shared/src/index.ts"],
      "@asimov/server/store": ["../server/src/lib/store.ts"],
      "@asimov/server/workspace": ["../server/src/lib/workspace.ts"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [{ "path": "../shared/tsconfig.build.json" }, { "path": "../server/tsconfig.build.json" }]
}
