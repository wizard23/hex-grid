// Dev container: Node 22 + the Codex and Claude Code CLIs, preinstalled.
// "Reopen in Container" (VS Code) or `devcontainer up` gives an agent-ready env.
{
  "name": "asimov minimal workspace",
  "build": { "dockerfile": "Dockerfile" },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  },
  // non-root, so files created in the mounted workspace aren't root-owned
  "remoteUser": "node",
  // install the workspace deps once after the container is created
  "postCreateCommand": "npm install",
  // the CLIs are installed but not authenticated — pass keys through from the
  // host env if set (nothing secret is committed; empty when unset)
  "remoteEnv": {
    "ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}",
    "OPENAI_API_KEY": "${localEnv:OPENAI_API_KEY}"
  }
}
